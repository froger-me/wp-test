<?xml version="1.0" encoding="UTF-8"?>
<!--
	This file documents the base PHPUnit policy.
	composer test generates runtime/phpunit.xml with discovered extension suites.
-->
<phpunit
	bootstrap="bootstrap.php"
	colors="true"
	failOnRisky="true"
	failOnWarning="true"
	cacheResult="false"
	convertDeprecationsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
>
	<testsuites>
		<testsuite name="Harness">
			<directory suffix="Test.php">tests</directory>
		</testsuite>
	</testsuites>
	<groups>
		<exclude>
			<group>destructive</group>
		</exclude>
	</groups>
</phpunit>
