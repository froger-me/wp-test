<?xml version="1.0"?>
<ruleset name="anyape-wp-test-tools">
	<description>WordPress Coding Standards for Anyape WP Test Tools.</description>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="p"/>

	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress"/>
	<exclude-pattern>/fixtures/setup/*</exclude-pattern>

	<!-- Limit filename exceptions to PSR-4 source classes, PHPUnit's *Test.php
	     discovery convention, and the copyable dot-named config example. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/src/*.php</exclude-pattern>
		<exclude-pattern>/*/tests/phpunit/*Test\.php</exclude-pattern>
		<exclude-pattern>/tests/*Test\.php</exclude-pattern>
		<exclude-pattern>/anyape-wp-test-tools-config-example.php</exclude-pattern>
	</rule>
</ruleset>
